  dialogueLines:
  - dialogueText: "\"We don\u2019t really need other players around. It\u2019s better
      when it\u2019s just you and me in this world. You feel that too, right?\""
    option1:
      optionText: "[Yeah\u2026 I guess so.]"
      badPoints: 2
    option2:
      optionText: '[I actually like playing with lots of players.]'
      badPoints: 0
